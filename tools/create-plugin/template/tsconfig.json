{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "ui/**/*.ts", "ui/**/*.vue", "vite.ui.config.ts"],
  "exclude": ["ui/shims"]
}
